# Pinned versions. Change deliberately and say why in a comment here.
FC_VERSION=v1.17.0
FC_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
# Prebuilt guest kernel from the Firecracker CI bucket. The bucket publishes no
# checksum, so the sha256 is pinned here (taken from a fetch on 2026-10-18) and
# fetch-kernel.sh verifies against it. Update both lines together.
KERNEL_CI_PREFIX=firecracker-ci/v1.15/x86_64
KERNEL_VERSION=6.1.155
KERNEL_SHA256=e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2
UBUNTU_IMAGE=ubuntu:24.04
NODE_VERSION=v24.22.0
CLAUDE_CODE_VERSION=2.1.294
# Guest networking
TAP_DEV=hiisin-loota0
HOST_IP=172.16.0.1
GUEST_IP=172.16.0.2
NET_CIDR=172.16.0.0/24
# Host-side egress proxy (bin/egress-proxy.py) the guest must use for all traffic
PROXY_PORT=3128
# Host-side credential broker (bin/cred-broker.py): the guest's ANTHROPIC_BASE_URL;
# it adds the subscription token so the guest never holds one
BROKER_PORT=3129
# VM sizing
VCPUS=4
MEM_MIB=4096
CG_MEM_OVERHEAD_MIB=256   # VMM memory.max = MEM_MIB + this; cpu.max = VCPUS cores
ROOTFS_SIZE_GB=6   # upper bound at build; the image is shrunk to its contents
UPPER_SIZE=2G      # tmpfs holding all guest writes (overlay upper), lost at exit
